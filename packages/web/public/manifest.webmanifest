{
  "name": "Stash",
  "short_name": "Stash",
  "description": "Save links to your Stash library",
  "start_url": "/",
  "scope": "/",
  "dir": "ltr",
  "capture_links": [
    "existing-client-navigate",
    "new-client",
    "none"
  ],
  "categories": [],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "background_color": "#FFFFFF",
  "theme_color": "#FF4F00",
  "icons": [
