# Generated by install.sh. __PLACEHOLDERS__ are filled in automatically.
DOMAIN=__DOMAIN__

# Postgres & migrate
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__PG_ROOT_PASSWORD__
PGPASSWORD=__PG_ROOT_PASSWORD__
POSTGRES_DB=omnivore
PG_REPLICATION=false
PG_HOST=postgres
PG_PORT=5432
PG_DB=omnivore
PG_USER=app_user
PG_PASSWORD=__PG_APP_PASSWORD__
PG_POOL_MAX=20
NO_DEMO_USER=1

# API
API_ENV=local
IMAGE_PROXY_SECRET=__IMAGE_PROXY_SECRET__
JWT_SECRET=__JWT_SECRET__
SSO_JWT_SECRET=__SSO_JWT_SECRET__
GATEWAY_URL=http://api:8080/api
CONTENT_FETCH_URL=http://content-fetch:8080/?token=__CONTENT_FETCH_TOKEN__
VERIFICATION_TOKEN=__CONTENT_FETCH_TOKEN__
REST_BACKEND_ENDPOINT=http://api:8080/api
SKIP_UPLOAD_ORIGINAL=true
CONTENT_FETCH_QUEUE_ENABLED=true
AUTO_VERIFY=true
# install.sh sets this to false once your account exists
ENABLE_EMAIL_SIGNUP=true

# Storage (MinIO)
GCS_USE_LOCAL_HOST=true
GCS_UPLOAD_BUCKET=omnivore
MINIO_ACCESS_KEY=reader
MINIO_SECRET_KEY=__MINIO_SECRET__
AWS_ACCESS_KEY_ID=reader
AWS_SECRET_ACCESS_KEY=__MINIO_SECRET__
AWS_REGION=us-east-1
AWS_S3_ENDPOINT_URL=http://minio:9000
LOCAL_MINIO_URL=https://__DOMAIN__/bucket

# Redis
REDIS_URL=redis://redis:6379/0
EXPORT_QUEUE_NAME=omnivore-backend-queue

# Public URLs
APP_ENV=prod
BASE_URL=https://__DOMAIN__
CLIENT_URL=https://__DOMAIN__
SERVER_BASE_URL=https://__DOMAIN__
HIGHLIGHTS_BASE_URL=https://__DOMAIN__
IMAGE_PROXY_URL=https://__DOMAIN__/images

# Stash's restyled web app, built by .github/workflows/build-stash-web.yml
WEB_IMAGE=ghcr.io/nigeldunckley/stash-web:latest

# Unused features that the API still expects to be set
WATCHER_API_KEY=__WATCHER_API_KEY__
LOCAL_EMAIL_DOMAIN=__DOMAIN__
SNS_ARN=unused
